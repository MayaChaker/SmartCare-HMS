# Server
PORT=5000
# Use "production" when deployed (enables HSTS and disables localhost CORS)
NODE_ENV=development

# Authentication
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_secure_random_string

# First admin account, created on startup if it does not exist yet (password: 8+ characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional public demo: DEMO_PASSWORD (8+ characters) enables the demo accounts,
# DEMO_RESET_TOKEN protects POST /api/demo/reset
DEMO_PASSWORD=
DEMO_RESET_TOKEN=

# Comma-separated frontend URLs allowed to call the API, e.g. https://your-app.vercel.app
CORS_ORIGINS=

# Database: either a full connection URL (hosted MySQL, SSL enabled)...
DATABASE_URL=

# ...or separate settings for a local MySQL server
DB_NAME=smartcare_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
